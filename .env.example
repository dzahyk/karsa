# Karsa (formerly DecisionFlow AI) — environment variables (copy to .env; never commit real secrets)

# Database. Default: SQLite file at backend/decisionflow.db. Postgres also works, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/decisionflow   (install a driver first)
DATABASE_URL=

# Requirement extraction provider: "demo" (rule-based, offline, default) or "anthropic".
# If "anthropic" is set without a key, the app falls back to "demo" and says so on /api/v1/health.
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Display timezone (stored times are UTC)
APP_TIMEZONE=Asia/Jakarta

# One-click sign-in for synthetic demo accounts (and the account list on the login page). Set false outside demos.
DEMO_MODE=true
# Send cookies only over HTTPS. Set true when served behind TLS.
COOKIE_SECURE=false
# Run the outbox worker inside the API process. Set false and run `python -m app.worker` separately to scale out.
WORKER_ENABLED=true
# Serve a built frontend from this folder (used by the Docker image).
STATIC_DIR=
