# Copy to .env (git-ignored). setup.sh creates .env with random values if it does not exist.
N8N_ENCRYPTION_KEY=change-me
# Shared secret the sender puts in the X-Intake-Secret header.
KARSA_INTAKE_SECRET=change-me
# Karsa API as seen from inside the n8n container (the API runs on the host).
KARSA_API_URL=http://host.docker.internal:8077/api/v1
# Synthetic demo analyst from Karsa's seed data. Not a real person.
KARSA_USERNAME=nadia
KARSA_PASSWORD=decisionflow-demo
# Local n8n owner account, used only to open the editor on this machine.
N8N_OWNER_EMAIL=owner@karsa.test
N8N_OWNER_PASSWORD=change-me
